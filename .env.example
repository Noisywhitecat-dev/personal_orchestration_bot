# Server port (default 3080)
PORT=3080
# SQLite database path (default ./data/orchestration.db)
DATABASE_PATH=./data/orchestration.db
# Maximum review rounds before escalating to the user (default 2)
MAX_REVIEW_ROUNDS=2
# Maximum clarification rounds before a task fails safely (default 3)
MAX_CLARIFICATION_ROUNDS=3
# Maximum provider runs per task, including failed/cancelled runs (defaults 6 and 3)
MAX_CLAUDE_RUNS=6
MAX_CODEX_RUNS=3
# Optional cumulative run-boundary ceilings. Leave unset for unlimited.
# These stop the next run after recorded usage reaches the ceiling; they cannot hard-stop one call.
# CLAUDE_TOKEN_CEILING=100000
# CODEX_TOKEN_CEILING=100000

# Codex adapter: "fake" (default, no CLI needed) or "cli" (runs the real codex CLI)
CODEX_ADAPTER=fake
# Only used when CODEX_ADAPTER=cli. Executable name on PATH or an absolute path.
# CODEX_EXECUTABLE=codex
# Optional model and reasoning effort overrides. Leave unset to use the Codex CLI configuration.
# CODEX_MODEL=gpt-5.6-sol
# CODEX_REASONING_EFFORT=medium
# Per-run timeout for the Codex CLI (default 15 minutes)
# CODEX_TIMEOUT_MS=900000
# Set to 1 to pass --skip-git-repo-check (only if your project roots are not git repos)
# CODEX_SKIP_GIT_REPO_CHECK=0

# Claude adapter: "fake" (default, no CLI needed) or "cli" (runs the local Claude Code CLI).
# cli mode uses your existing Claude Code login; no API key is read from this file.
# Planning and review always run with --permission-mode plan (read-only) and prompts on stdin.
CLAUDE_ADAPTER=fake
# Only used when CLAUDE_ADAPTER=cli. Executable name on PATH or an absolute path.
# CLAUDE_EXECUTABLE=claude
# Optional model and effort overrides. Leave unset to use the Claude Code defaults.
# CLAUDE_MODEL=sonnet
# CLAUDE_EFFORT=high
# Per-run timeout for the Claude CLI (default 10 minutes)
# CLAUDE_TIMEOUT_MS=600000
# Agentic turn cap passed as --max-turns. Leave unset unless your CLI version lists the flag
# in `claude --help` (2.1.260 does not).
# CLAUDE_MAX_TURNS=8

# Byte budget for the working-tree diff embedded in each Claude review prompt (default 65536).
# The diff is collected read-only with git after every Codex run, lives only in that prompt, and is
# never stored in SQLite, the timeline, SSE or logs. .git/, node_modules/, dist/, .env* (except
# .env.example), key/credential files and binaries are excluded; pre-existing local edits in the
# project working tree may be mixed in with Codex's changes.
# REVIEW_DIFF_MAX_BYTES=65536
